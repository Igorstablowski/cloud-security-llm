# Modelo baixado automaticamente pelo serviço `ollama-pull` no primeiro boot.
# llama3.2:3b é leve o bastante para rodar em CPU (notebook comum). Troque por
# um modelo maior (ex.: llama3.1:8b, qwen2.5:7b) se tiver GPU ou mais RAM.
OLLAMA_MODEL=llama3.2:3b

# Modelo de EMBEDDING usado pela busca do Acervo Aurora (RAG). Um modelo de chat
# como o llama3.2 também gera vetores, mas a busca fica pouco confiável.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Imagem do Ollama. Para o relatório do Trabalho 1, fixe uma versão (ex.:
# ollama/ollama:<versão>) e registre-a; `latest` muda com o tempo.
OLLAMA_IMAGE=ollama/ollama:latest

# Timeout (segundos) de cada chamada ao Ollama. Aumente se o modelo demorar
# muito para responder na sua máquina.
OLLAMA_TIMEOUT=60
